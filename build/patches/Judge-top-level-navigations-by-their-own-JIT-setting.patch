 .../renderer_host/navigation_request.cc        | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/content/browser/renderer_host/navigation_request.cc b/content/browser/renderer_host/navigation_request.cc
--- a/content/browser/renderer_host/navigation_request.cc
+++ b/content/browser/renderer_host/navigation_request.cc
@@ -4850,17 +4850,21 @@ UrlInfo NavigationRequest::GetUrlInfo() {
   // Compute the WebExposedIsolationInfo that will be bundled into UrlInfo.
   auto web_exposed_isolation_info = ComputeWebExposedIsolationInfo();
 
-  url::Origin top_origin = frame_tree_node_
-      ->current_frame_host()
-      ->GetMainFrame()
-      ->GetLastCommittedOrigin();
-
   UrlInfoInit url_info_init(GetURL());
   url_info_init.WithOACHeaderRequest(oac_header_request)
       .WithCOOPSiteIsolation(ShouldRequestSiteIsolationForCOOP())
       .WithWebExposedIsolationInfo(web_exposed_isolation_info)
-      .WithEmbedderIsolationInfo(embedder_isolation_info_)
-      .WithTopOrigin(top_origin);
+      .WithEmbedderIsolationInfo(embedder_isolation_info_);
+
+  // The top origin can only turn JIT on: a page with JIT allowed also allows
+  // JIT in its subframes, and a page with JIT blocked does not take JIT away
+  // from a subframe whose own setting allows it. For a main frame the current
+  // page is the one being left, so the destination keeps its own setting.
+  if (!frame_tree_node_->IsMainFrame()) {
+    url_info_init.WithTopOrigin(frame_tree_node_->current_frame_host()
+                                    ->GetMainFrame()
+                                    ->GetLastCommittedOrigin());
+  }
 
   if (base::FeatureList::IsEnabled(features::kExcludeAdsFromOriginIsolation)) {
     // After the final response, use the decision from
