+  original_url_ = url_;
+  // The download and fallback addresses belong to the address before the
+  // redirect.
+  fallback_url_ = GURL();
+  download_url_ = GURL();
   StartWhenRequestsAllowed();
 }
 
@@ -99,6 +108,18 @@ size_t AdblockResourceRequestImpl::GetNumberOfRedirects() const {
   return number_of_redirects_;
 }
 
+void AdblockResourceRequestImpl::SetFallbackUrl(const GURL& fallback_url) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(!IsStarted()) << "SetFallbackUrl() called after Start()";
+  fallback_url_ = fallback_url;
+}
+
+void AdblockResourceRequestImpl::SetDownloadUrl(const GURL& download_url) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(!IsStarted()) << "SetDownloadUrl() called after Start()";
+  download_url_ = download_url;
+}
