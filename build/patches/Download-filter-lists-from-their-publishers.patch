@@ -54,6 +54,16 @@ class AdblockResourceRequest {
                         const std::string extra_query_params = "") = 0;
 
   virtual size_t GetNumberOfRedirects() const = 0;
+
+  // Sets a second address for the resource. Retries alternate between the
+  // first download address (see SetDownloadUrl()) and this one. Must be called
+  // before Start().
+  virtual void SetFallbackUrl(const GURL& fallback_url) {}
+
+  // Sets the address to download from instead of the address given to Start().
+  // Responses are still reported for the address given to Start(). Must be
+  // called before Start().
+  virtual void SetDownloadUrl(const GURL& download_url) {}
 };
 
