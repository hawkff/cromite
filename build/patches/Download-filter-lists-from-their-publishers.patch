+// A subscription to the project site's copy of a list that its publisher
+// serves is moved to the publisher's address.
+void MoveSubscriptionsToPublishers(
+    FilteringConfiguration* adblock_filtering_configuration) {
+  const std::vector<GURL> filter_lists =
+      adblock_filtering_configuration->GetFilterLists();
+  for (const auto& known : config::GetKnownSubscriptions()) {
+    if (known.fallback_url.host() == AdblockBaseFilterListUrl().host() &&
+        std::ranges::contains(filter_lists, known.fallback_url)) {
+      VLOG(1) << "[eyeo] Moving subscription " << known.fallback_url << " to "
+              << known.url;
+      adblock_filtering_configuration->RemoveFilterList(known.fallback_url);
+      adblock_filtering_configuration->AddFilterList(known.url);
+    }
+  }
+}
