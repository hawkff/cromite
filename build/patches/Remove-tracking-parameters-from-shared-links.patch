diff --git a/ui/android/java/src/org/chromium/ui/base/LinkCleaner.java b/ui/android/java/src/org/chromium/ui/base/LinkCleaner.java
new file mode 100644
--- /dev/null
+++ b/ui/android/java/src/org/chromium/ui/base/LinkCleaner.java
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.chromium.ui.base;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Removes known tracking parameters from links that leave the browser through the clipboard or
+ * the share sheet. Links the user opens are not changed.
+ */
+@NullMarked
+public final class LinkCleaner {
+    /**
+     * App preference, on by default, that turns link cleaning on or off. The privacy settings
+     * switch writes it under the same key.
+     */
+    public static final String PREF_CLEAN_LINKS = "clean_links";
+
+    // Campaign tags of the utm_ family: utm_source, utm_medium, utm_campaign, utm_term, ...
+    private static final String CAMPAIGN_TAG_PREFIX = "utm_";
+
+    // Ad click identifiers, share identifiers and email campaign tokens.
+    private static final List<String> TRACKING_PARAMS =
+            Arrays.asList(
+                    "fbclid", // Meta (Facebook, Instagram) click identifier.
+                    "gclid", // Google Ads click identifier.
+                    "gclsrc", // Google Ads, source of the gclid.
+                    "dclid", // Google display ads (Campaign Manager) click identifier.
+                    "gbraid", // Google Ads click identifier, app to web.
+                    "wbraid", // Google Ads click identifier, web to app.
+                    "gad_source", // Google Ads, ad source marker.
+                    "srsltid", // Google Merchant Center click identifier.
+                    "_gl", // Google Analytics cross-domain client identifier.
+                    "msclkid", // Microsoft Advertising click identifier.
+                    "yclid", // Yandex Direct click identifier.
+                    "ysclid", // Yandex Search click identifier.
+                    "twclid", // X (Twitter) Ads click identifier.
+                    "ttclid", // TikTok Ads click identifier.
+                    "li_fat_id", // LinkedIn ads member identifier.
+                    "epik", // Pinterest Ads click identifier.
+                    "igshid", // Instagram share identifier.
+                    "igsh", // Instagram share identifier, newer form.
+                    "mibextid", // Facebook app share identifier.
+                    "mc_cid", // Mailchimp campaign identifier.
+                    "mc_eid", // Mailchimp recipient identifier.
+                    "_hsenc", // HubSpot email tracking token.
+                    "_hsmi", // HubSpot email message identifier.
+                    "mkt_tok"); // Marketo email tracking token.
+
+    private LinkCleaner() {}
+
+    /** Returns {@link #clean(String)} of the link, or the link itself if the switch is off. */
+    public static String cleanIfEnabled(String url) {
+        return cleanIfEnabled(url, null);
+    }
+
+    /**
+     * Like {@link #cleanIfEnabled(String)}, but the site-specific rules match siteHost, the host as
+     * a URL parser resolves it, when it is not null. Use it for text that may spell the host
+     * differently, such as "%78.com" for "x.com"; the returned text keeps that spelling.
+     */
+    public static String cleanIfEnabled(String url, @Nullable String siteHost) {
+        if (!ContextUtils.getAppSharedPreferences().getBoolean(PREF_CLEAN_LINKS, true)) {
+            return url;
+        }
+        return clean(url, siteHost);
+    }
+
+    /**
+     * Returns the http or https URL without known tracking parameters. The other parameters keep
+     * their order and bytes, and the fragment is kept. The "?" goes only when nothing is left of
+     * the query. A parameter name is compared after decoding its percent escapes, so "%66bclid"
+     * counts as "fbclid"; a name with an invalid or incomplete escape is kept. Anything that is not
+     * a single http or https URL with a host is returned unchanged.
+     */
+    public static String clean(String url) {
+        return clean(url, null);
+    }
+
+    private static String clean(String url, @Nullable String siteHost) {
+        int schemeEnd = url.indexOf("://");
+        if (schemeEnd < 0) return url;
+        String scheme = url.substring(0, schemeEnd);
+        if (!scheme.equalsIgnoreCase("http") && !scheme.equalsIgnoreCase("https")) return url;
+        for (int i = 0; i < url.length(); i++) {
+            char c = url.charAt(i);
+            // Spaces, line breaks and backslashes: text around a URL, or a URL we do not parse.
+            if (c <= ' ' || c == 0x7f || c == '\\') return url;
+        }
+
+        int queryEnd = url.indexOf('#');
+        if (queryEnd < 0) queryEnd = url.length();
+        int queryStart = url.indexOf('?');
+        if (queryStart < 0 || queryStart > queryEnd) return url;
+
+        int authorityStart = schemeEnd + 3;
+        int authorityEnd = url.indexOf('/', authorityStart);
+        if (authorityEnd < 0 || authorityEnd > queryStart) authorityEnd = queryStart;
+        String host = getHost(url.substring(authorityStart, authorityEnd));
+        if (host.isEmpty()) return url;
+        if (siteHost != null) host = getHost(siteHost);
+
+        String[] params = url.substring(queryStart + 1, queryEnd).split("&", -1);
+        List<String> kept = new ArrayList<>();
+        for (String param : params) {
+            int nameEnd = param.indexOf('=');
+            String name = decodeName(nameEnd < 0 ? param : param.substring(0, nameEnd));
+            if (name == null || !isTrackingParam(name, host)) kept.add(param);
+        }
+        if (kept.size() == params.length) return url;
+
+        String beforeQuery = url.substring(0, queryStart);
+        String query = String.join("&", kept);
+        String fragment = url.substring(queryEnd);
+        if (query.isEmpty()) return beforeQuery + fragment;
+        return beforeQuery + "?" + query + fragment;
+    }
+
+    /**
+     * Returns the lower case host of an authority, without user info, port and final dot, or an
+     * empty string if an IPv6 host has no closing bracket or is followed by anything but a port.
+     */
+    private static String getHost(String authority) {
+        String host = authority.substring(authority.lastIndexOf('@') + 1);
+        if (host.startsWith("[")) {
+            int bracketEnd = host.indexOf(']');
+            if (bracketEnd < 0 || !host.substring(bracketEnd + 1).matches("(:[0-9]*)?")) return "";
+        }
+        int portStart = host.lastIndexOf(':');
+        // A colon inside the brackets of an IPv6 address is not a port separator.
+        if (portStart > host.lastIndexOf(']')) host = host.substring(0, portStart);
+        // "youtube.com." names the same site as "youtube.com".
+        if (host.endsWith(".")) host = host.substring(0, host.length() - 1);
+        return host.toLowerCase(Locale.ROOT);
+    }
+
+    /**
+     * Returns the name with its percent escapes decoded, each escape as one char of that byte
+     * value, or null if an escape is invalid or incomplete. A "+" stays as it is.
+     */
+    private static @Nullable String decodeName(String name) {
+        if (name.indexOf('%') < 0) return name;
+        StringBuilder decoded = new StringBuilder(name.length());
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            if (c == '%') {
+                if (i + 2 >= name.length()) return null;
+                int high = hexDigit(name.charAt(i + 1));
+                int low = hexDigit(name.charAt(i + 2));
+                if (high < 0 || low < 0) return null;
+                c = (char) (high * 16 + low);
+                i += 2;
+            }
+            decoded.append(c);
+        }
+        return decoded.toString();
+    }
+
+    /** Returns the value of an ASCII hex digit, or -1. */
+    private static int hexDigit(char c) {
+        return c < 0x80 ? Character.digit(c, 16) : -1;
+    }
+
+    private static boolean isTrackingParam(String name, String host) {
+        if (name.startsWith(CAMPAIGN_TAG_PREFIX) || TRACKING_PARAMS.contains(name)) return true;
+        switch (name) {
+            case "si": // YouTube and Spotify share identifier.
+                return isOnSite(host, "youtube.com")
+                        || isOnSite(host, "youtu.be")
+                        || isOnSite(host, "spotify.com");
+            case "s": // X (Twitter) share source.
+            case "t": // X (Twitter) share token.
+                return isOnSite(host, "x.com") || isOnSite(host, "twitter.com");
+            default:
+                return false;
+        }
+    }
+
+    private static boolean isOnSite(String host, String site) {
+        return host.equals(site) || host.endsWith("." + site);
+    }
+}
diff --git a/ui/android/junit/src/org/chromium/ui/base/LinkCleanerTest.java b/ui/android/junit/src/org/chromium/ui/base/LinkCleanerTest.java
new file mode 100644
--- /dev/null
+++ b/ui/android/junit/src/org/chromium/ui/base/LinkCleanerTest.java
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.chromium.ui.base;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Tests for {@link LinkCleaner}. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class LinkCleanerTest {
+    private static void assertCleaned(String expected, String url) {
+        assertEquals(expected, LinkCleaner.clean(url));
+    }
+
+    private static void assertUnchanged(String url) {
+        assertEquals(url, LinkCleaner.clean(url));
+    }
+
+    @Test
+    public void testRemovesTrackingParamsAndKeepsTheRest() {
+        assertCleaned(
+                "https://example.com/p?a=1&b=2#frag",
+                "https://example.com/p?a=1&utm_source=news&b=2&fbclid=XYZ#frag");
+        assertCleaned(
+                "https://example.com/?id=7",
+                "https://example.com/?gclid=1&id=7&utm_campaign_name=x&msclkid=2");
+        assertCleaned("http://example.com/a?b", "http://example.com/a?b&mc_eid=1&mc_cid=2");
+    }
+
+    @Test
+    public void testKeepsOrderAndEncodingOfOtherParams() {
+        assertCleaned(
+                "https://example.com/s?z=%E2%9C%93&a=b+c&q=x%26y",
+                "https://example.com/s?z=%E2%9C%93&utm_medium=m&a=b+c&yclid=1&q=x%26y");
+    }
+
+    @Test
+    public void testRemovesQuestionMarkOnlyWhenNothingIsLeft() {
+        assertCleaned("https://example.com/p", "https://example.com/p?utm_source=a&ttclid=b");
+        assertCleaned("https://example.com/p#top", "https://example.com/p?twclid=1#top");
+        assertCleaned("https://example.com/p", "https://example.com/p?fbclid=1&");
+        assertCleaned("https://example.com/p?a=1&", "https://example.com/p?a=1&fbclid=1&");
+        assertCleaned("https://example.com/?a", "https://example.com/?fbclid&a");
+        assertCleaned("https://example.com/p?&&#frag", "https://example.com/p?&fbclid=x&&#frag");
+        assertUnchanged("https://example.com/?");
+        assertUnchanged("https://example.com/?a=1&&b=2");
+    }
+
+    @Test
+    public void testLeavesUrlsWithoutTrackingParamsAlone() {
+        assertUnchanged("https://example.com/");
+        assertUnchanged("https://example.com/search?q=utm_source&next=%3Ffbclid%3D1");
+        assertUnchanged("https://example.com/?gclid_extra=1&xfbclid=2&UTM_SOURCE=3");
+        assertUnchanged("https://example.com/page#section?utm_source=x");
+        assertUnchanged("https://example.com/#/route?fbclid=1");
+    }
+
+    @Test
+    public void testLeavesOtherSchemesAlone() {
+        assertUnchanged("mailto:a@example.com?subject=hi&utm_source=x");
+        assertUnchanged("ftp://example.com/f?utm_source=x");
+        assertUnchanged("file:///sdcard/page.html?utm_source=x");
+        assertUnchanged("chrome://history/?utm_source=x");
+        assertUnchanged("intent://example.com/?utm_source=x#Intent;scheme=https;end");
+        assertUnchanged("example.com/?utm_source=x");
+        assertUnchanged("");
+    }
+
+    @Test
+    public void testLeavesTextAndMalformedUrlsAlone() {
+        assertUnchanged("https://example.com/?utm_source=x and more text");
+        assertUnchanged("https://example.com/?a=1\nhttps://example.org/?utm_source=x");
+        assertUnchanged("https:///?utm_source=x");
+        assertUnchanged("https://example.com\\@evil.example/?utm_source=x");
+    }
+
+    @Test
+    public void testDecodesPercentEscapesInNamesOnly() {
+        assertCleaned("https://example.com/?a=%2F", "https://example.com/?%66bclid=x&a=%2F");
+        assertCleaned(
+                "https://example.com/?a=1", "https://example.com/?a=1&utm%5Fsource=x&%67clid");
+        assertCleaned("https://x.com/u?lang=en", "https://x.com/u?%73=1&%74=2&lang=en");
+        // Names are matched case-sensitively after decoding.
+        assertUnchanged("https://example.com/?%55TM_source=x");
+        assertUnchanged("https://example.com/?%61=1&b%3D=2&fb%2Bclid=3");
+        assertUnchanged("https://example.com/?fb+clid=1&a=%66bclid");
+        assertUnchanged("https://example.com/?%zzfbclid=1&utm_%zz=2&utm_%4=3&utm_%=4");
+        assertUnchanged("https://example.com/?%\u0666\u0666bclid=1");
+    }
+
+    @Test
+    public void testIpv6Hosts() {
+        assertCleaned("https://[2001:db8::1]/?a=1", "https://[2001:db8::1]/?a=1&utm_source=x");
+        assertCleaned("https://[2001:db8::1]:8080/p#f", "https://[2001:db8::1]:8080/p?fbclid=x#f");
+        assertCleaned("https://[2001:db8::1]?a", "https://[2001:db8::1]?a&fbclid=x");
+        assertUnchanged("https://[/?utm_source=x");
+        assertUnchanged("https://[2001:db8::1/?utm_source=x");
+        assertUnchanged("https://user@[2001:db8::1?utm_source=x");
+        assertUnchanged("https://[2001:db8::1]x/?utm_source=x");
+        assertUnchanged("https://[2001:db8::1]:80x/?utm_source=x");
+    }
+
+    @Test
+    public void testSchemeAndHostAreCaseInsensitive() {
+        assertCleaned("HTTPS://WWW.YOUTUBE.COM/watch?v=a", "HTTPS://WWW.YOUTUBE.COM/watch?v=a&si=b");
+        assertCleaned("Http://example.com/", "Http://example.com/?utm_source=x");
+    }
+
+    @Test
+    public void testSiteSpecificParams() {
+        assertCleaned("https://youtu.be/abc?t=42", "https://youtu.be/abc?si=XYZ&t=42");
+        assertCleaned(
+                "https://www.youtube.com/watch?v=abc", "https://www.youtube.com/watch?v=abc&si=Q");
+        assertCleaned("https://open.spotify.com/track/1", "https://open.spotify.com/track/1?si=Z");
+        assertCleaned("https://x.com/u/status/1", "https://x.com/u/status/1?s=20&t=abc");
+        assertCleaned(
+                "https://user@mobile.twitter.com:8443/u?lang=en",
+                "https://user@mobile.twitter.com:8443/u?s=46&lang=en");
+        assertUnchanged("https://example.com/?si=1&s=search&t=2");
+        assertUnchanged("https://notx.com/?s=1&t=2");
+        assertCleaned(
+                "https://www.youtube.com./watch?v=abc",
+                "https://www.youtube.com./watch?v=abc&si=Q");
+        assertUnchanged("https://x.com.example.org/?s=1");
+        assertUnchanged("https://[2001:db8::1]:8080/?s=1&t=2");
+    }
+
+    @Test
+    public void testSwitch() {
+        String url = "https://example.com/?utm_source=x";
+        assertEquals("https://example.com/", LinkCleaner.cleanIfEnabled(url));
+        ContextUtils.getAppSharedPreferences()
+                .edit()
+                .putBoolean(LinkCleaner.PREF_CLEAN_LINKS, false)
+                .apply();
+        assertEquals(url, LinkCleaner.cleanIfEnabled(url));
+    }
+}
--
