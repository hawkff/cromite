+
+#if BUILDFLAG(IS_ANDROID)
+
+    {"report-exec-memory-in-jitless-renderers",
+     "Report executable memory in renderers without JIT",
+     "Logs every request of a renderer without JIT to map executable memory "
+     "or to make memory executable, and lets the request succeed. For "
+     "diagnosis only.", kOsAndroid,
+     FEATURE_VALUE_TYPE(
+         sandbox::policy::features::kReportExecMemoryInJitlessRenderers)},
+
+    {"no-exec-memory-in-jitless-renderers",
+     "Block executable memory in renderers without JIT",
+     "Ends a renderer without JIT when it asks for new executable memory "
+     "through mmap, mmap2, mprotect or pkey_mprotect. On by default on "
+     "Android 17 and later. Memory that is already writable and executable, "
+     "such as the Java runtime's code cache before Android 17, stays usable, "
+     "and writes through /proc/self/mem are not covered. Takes precedence "
+     "over the report flag, so on Android 17 and later the report flag needs "
+     "this one set to Disabled.", kOsAndroid,
+     FEATURE_VALUE_TYPE(
+         sandbox::policy::features::kNoExecMemoryInJitlessRenderers)},
+
+#endif
+
+#endif // ifdef FLAG_SECTION
diff --git a/sandbox/policy/features.cc b/sandbox/policy/features.cc
--- a/sandbox/policy/features.cc
+++ b/sandbox/policy/features.cc
@@ -12,6 +12,12 @@
 #include "base/win/windows_version.h"
 #endif
 
+#if BUILDFLAG(IS_ANDROID)
+#include <android/api-level.h>
+
+#include "base/android/android_info.h"
+#endif
+
 namespace sandbox::policy::features {
 
 #if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_FUCHSIA)
@@ -141,6 +147,37 @@ BASE_FEATURE(kRestrictRendererPoliciesInBaseline,
 // When enabled, restrict clone to just flags used by fork and pthread_create on
 // android.
 BASE_FEATURE(kRestrictCloneParameters, base::FEATURE_ENABLED_BY_DEFAULT);
+// Logs the requests of renderers running V8 with --jitless to map executable
+// memory or to make memory executable, and lets them succeed.
+CROMITE_FEATURE(kReportExecMemoryInJitlessRenderers,
+                "ReportExecMemoryInJitlessRenderers",
+                base::FEATURE_DISABLED_BY_DEFAULT);
+// Crashes renderers running V8 with --jitless when they ask to map executable
+// memory or to make memory executable. Takes precedence over
+// kReportExecMemoryInJitlessRenderers. On by default from Android 17, where
+// renderers on the primary ABI run without the Java runtime and its writable
+// JIT code cache. This is CROMITE_FEATURE written out, because the default is
+// read from the system at startup: every process of the browser computes the
+// same default, and a state chosen on chrome://flags takes precedence.
+constinit const base::Feature kNoExecMemoryInJitlessRenderers(
+    "NoExecMemoryInJitlessRenderers",
+    base::FEATURE_DISABLED_BY_DEFAULT,
+    /*is_runtime_mutable=*/false,
+    base::internal::FeatureMacroHandshake::kSecret,
+    /*cromite=*/true,
+    /*is_new_flag=*/true);
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wglobal-constructors"
+// android_get_device_api_level() reads a system property, so it works before
+// JNI is set up and in renderers without Java, unlike android_info::sdk_int().
+static const ::base::internal::FeatureDefaultStateOverrider
+    g_feature_default_state_overrider_kNoExecMemoryInJitlessRenderers{
+        kNoExecMemoryInJitlessRenderers,
+        android_get_device_api_level() >=
+                base::android::android_info::SDK_VERSION_CINNAMON_BUN
+            ? base::FEATURE_ENABLED_BY_DEFAULT
+            : base::FEATURE_DISABLED_BY_DEFAULT};
+#pragma clang diagnostic pop
 #endif  // BUILDFLAG(IS_ANDROID)
 
 #if BUILDFLAG(IS_WIN)
diff --git a/sandbox/policy/features.h b/sandbox/policy/features.h
--- a/sandbox/policy/features.h
+++ b/sandbox/policy/features.h
@@ -60,6 +60,8 @@ SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kSeccompFilterGpuSandbox);
 SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kUseRendererProcessPolicy);
 SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kRestrictRendererPoliciesInBaseline);
 SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kRestrictCloneParameters);
+SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kReportExecMemoryInJitlessRenderers);
+SANDBOX_POLICY_EXPORT BASE_DECLARE_FEATURE(kNoExecMemoryInJitlessRenderers);
 #endif  // BUILDFLAG(IS_ANDROID)
 
