diff --git a/content/renderer/renderer_main_platform_delegate_android.cc b/content/renderer/renderer_main_platform_delegate_android.cc
--- a/content/renderer/renderer_main_platform_delegate_android.cc
+++ b/content/renderer/renderer_main_platform_delegate_android.cc
@@ -12,15 +12,79 @@
 #include "sandbox/sandbox_buildflags.h"
 
 #if BUILDFLAG(USE_SECCOMP_BPF)
+#include <sys/mman.h>
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/memory/page_size.h"
+#include "base/strings/string_split.h"
 #include "sandbox/linux/seccomp-bpf-helpers/baseline_policy_android.h"
 #include "sandbox/policy/features.h"
 #include "sandbox/policy/linux/bpf_renderer_policy_linux.h"
 #include "sandbox/policy/mojom/sandbox.mojom.h"
 #include "sandbox/policy/sandbox_type.h"
+#include "third_party/blink/public/common/switches.h"
 #endif
 
 namespace content {
 
+#if BUILDFLAG(USE_SECCOMP_BPF)
+namespace {
+
+// Same test as the one that turns on dynamic code prohibition for renderers on
+// Windows. The browser always writes this exact token for renderers with JIT
+// blocked; hand-written --js-flags that turn JIT off with another spelling are
+// not recognized.
+bool IsJitless(const base::CommandLine& command_line) {
+  const std::string js_flags =
+      command_line.GetSwitchValueASCII(blink::switches::kJavaScriptFlags);
+  return std::ranges::contains(
+      base::SplitStringPiece(js_flags, ",", base::TRIM_WHITESPACE,
+                             base::SPLIT_WANT_NONEMPTY),
+      std::string_view("--jitless"));
+}
+
+// Logs the executable mappings that already exist and that are not read-only
+// private file mappings, such as the code cache of a Java runtime. The filter
+// only governs new requests, so these stay usable.
+void LogPreexistingExecMemory() {
+  std::string maps;
+  if (!base::ReadFileToString(base::FilePath("/proc/self/maps"), &maps)) {
+    return;
+  }
+  for (std::string_view line : base::SplitStringPiece(
+           maps, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    // Fields: range, permissions, offset, device, inode, optional path.
+    const std::vector<std::string_view> fields = base::SplitStringPiece(
+        line, " ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (fields.size() < 5 || fields[1].size() != 4 || fields[1][2] != 'x') {
+      continue;
+    }
+    const bool read_only_private =
+        fields[1][1] != 'w' && fields[1][3] == 'p';
+    const bool file_backed = fields[4] != "0";
+    // Only the kernel's own executable mappings are skipped by name.
+    const bool kernel_provided =
+        fields.size() > 5 &&
+        (fields[5] == "[vdso]" || fields[5] == "[vectors]" ||
+         fields[5] == "[sigpage]" || fields[5] == "[vsyscall]");
+    if ((read_only_private && file_backed) || kernel_provided) {
+      continue;
+    }
+    LOG(WARNING) << "Executable mapping before the sandbox: " << line;
+  }
+}
+
+}  // namespace
+#endif
+
 RendererMainPlatformDelegate::RendererMainPlatformDelegate(
     const MainFunctionParams& parameters) {}
 
@@ -54,6 +118,23 @@ bool RendererMainPlatformDelegate::EnableSandbox() {
           sandbox::policy::features::kRestrictCloneParameters)) {
     options.should_restrict_clone_params = true;
   }
+  // A renderer without JIT needs no new executable memory: V8 runs its
+  // interpreter and builtins from the loaded library.
+  if (IsJitless(*base::CommandLine::ForCurrentProcess())) {
+    if (base::FeatureList::IsEnabled(
+            sandbox::policy::features::kNoExecMemoryInJitlessRenderers)) {
+      options.exec_memory = sandbox::BaselinePolicyAndroid::ExecMemory::kDeny;
+    } else if (base::FeatureList::IsEnabled(
+                   sandbox::policy::features::
+                       kReportExecMemoryInJitlessRenderers)) {
+      options.exec_memory =
+          sandbox::BaselinePolicyAndroid::ExecMemory::kReport;
+    }
+    if (options.exec_memory !=
+        sandbox::BaselinePolicyAndroid::ExecMemory::kAllow) {
+      LogPreexistingExecMemory();
+    }
+  }
   if (sandbox::policy::SandboxTypeFromCommandLine(
           *base::CommandLine::ForCurrentProcess()) ==
           sandbox::mojom::Sandbox::kRenderer &&
@@ -67,6 +148,18 @@ bool RendererMainPlatformDelegate::EnableSandbox() {
   }
 #endif
   starter.StartSandbox();
+#if BUILDFLAG(USE_SECCOMP_BPF)
+  if (options.exec_memory ==
+      sandbox::BaselinePolicyAndroid::ExecMemory::kReport) {
+    // One request right after the start shows in the log that reporting works.
+    const size_t size = base::GetPageSize();
+    void* probe = mmap(nullptr, size, PROT_READ | PROT_EXEC,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (probe != MAP_FAILED) {
+      munmap(probe, size);
+    }
+  }
+#endif
 
   SetSeccompSandboxStatus(starter.status());
 
