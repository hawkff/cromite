---
 .../chrome/browser/LaunchIntentDispatcher.java    | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
@@ -551,9 +551,22 @@ public class LaunchIntentDispatcher {
         }
     }
 
+    /**
+     * Whether the custom tab for this link will open in a profile other than the regular one, so
+     * that the regular profile's hidden tab must not load it.
+     */
+    private boolean opensOutsideRegularProfile() {
+        // Judge an incognito request with the calling app's package, as the custom tab does.
+        Intent intent = new Intent(mIntent);
+        maybePutCallingAppPackage(intent);
+        return AlwaysIncognitoLinkInterceptor.isAlwaysIncognito()
+                || IntentHandler.willLaunchIncognitoCustomTab(intent)
+                || ChromeFeatureList.sMayLaunchurlUsesSeparateStoragePartition.isEnabled();
+    }
+
     private boolean maybeStartNavigation() {
         if (!ProfileManager.isInitialized()) return false;
-        if (IntentHandler.willLaunchIncognitoCustomTab(mIntent)) return false;
+        if (opensOutsideRegularProfile()) return false;
         if (clearTopIntentsForCustomTabsEnabled(mIntent)
                 && SessionDataHolder.getInstance()
                                 .getActiveHandlerClassInCurrentTask(mIntent, mActivity)
