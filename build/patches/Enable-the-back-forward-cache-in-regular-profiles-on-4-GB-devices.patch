diff --git a/chrome/browser/android/tab_web_contents_delegate_android.cc b/chrome/browser/android/tab_web_contents_delegate_android.cc
--- a/chrome/browser/android/tab_web_contents_delegate_android.cc
+++ b/chrome/browser/android/tab_web_contents_delegate_android.cc
@@ -795,7 +795,8 @@ void TabWebContentsDelegateAndroid::ExitPictureInPicture() {
 
 bool TabWebContentsDelegateAndroid::IsBackForwardCacheSupported(
     content::WebContents& web_contents) {
-  return true;
+  // Pages of off-the-record profiles are not stored in the back/forward cache.
+  return !web_contents.GetBrowserContext()->IsOffTheRecord();
 }
 
 content::PreloadingEligibility
diff --git a/components/adblock/content/browser/adblock_webcontents_observer.cc b/components/adblock/content/browser/adblock_webcontents_observer.cc
--- a/components/adblock/content/browser/adblock_webcontents_observer.cc
+++ b/components/adblock/content/browser/adblock_webcontents_observer.cc
@@ -168,6 +168,11 @@ void AdblockWebContentObserver::DidFinishNavigation(
   if (!frame) {
     return;
   }
+  if (navigation_handle->IsServedFromBackForwardCache()) {
+    // The restored document still has the element hiding and snippets that
+    // were applied when it was loaded.
+    return;
+  }
   if (ShouldSkipElementHiding(url)) {
     VLOG(1) << "[eyeo] Unsupported scheme, skipping injection.";
     return;
diff --git a/components/content_settings/browser/page_specific_content_settings.cc b/components/content_settings/browser/page_specific_content_settings.cc
--- a/components/content_settings/browser/page_specific_content_settings.cc
+++ b/components/content_settings/browser/page_specific_content_settings.cc
@@ -33,6 +33,7 @@
 #include "components/content_settings/core/common/content_settings_types.mojom-shared.h"
 #include "components/content_settings/core/common/content_settings_utils.h"
 #include "components/privacy_sandbox/privacy_sandbox_features.h"
+#include "content/public/browser/back_forward_cache.h"
 #include "content/public/browser/browser_thread.h"
 #include "content/public/browser/cookie_access_details.h"
 #include "content/public/browser/navigation_handle.h"
@@ -1387,6 +1388,28 @@ void PageSpecificContentSettings::OnContentSettingChanged(
   if (IsEmbeddedPage())
     return;
 
+  // A page keeps the renderer rules, the process (with its JIT and optimizer
+  // mode), its workers, and the ad blocking and local network access
+  // decisions made when it was loaded. After one of those settings changes,
+  // the page must not come back from the back/forward cache: a cached page is
+  // evicted, an active page will not be stored. Cookie settings also decide
+  // whether third-party service and shared workers may run. DEFAULT is a
+  // change of all types at once, for example a policy update. Reason id 0 is
+  // the embedder's "unknown" reason, which the metrics enums already list.
+  if (content_type == ContentSettingsType::DEFAULT ||
+      RendererContentSettingRules::IsRendererContentSetting(content_type) ||
+      content_type == ContentSettingsType::JAVASCRIPT_OPTIMIZER ||
+      content_type == ContentSettingsType::COOKIES ||
+      content_type == ContentSettingsType::ADS ||
+      content_type == ContentSettingsType::INSECURE_PRIVATE_NETWORK) {
+    content::BackForwardCache::DisableForRenderFrameHost(
+        &page().GetMainDocument(),
+        content::BackForwardCache::DisabledReason(
+            content::BackForwardCache::DisabledSource::kEmbedder, /*id=*/0,
+            "Content setting changed", /*context=*/"",
+            /*report_string=*/"masked"));
+  }
+
   const GURL current_url = page().GetMainDocument().GetLastCommittedURL();
   if (content_type == ContentSettingsType::STORAGE_ACCESS) {
     if (!secondary_pattern.Matches(current_url)) {
diff --git a/content/common/content_navigation_policy.cc b/content/common/content_navigation_policy.cc
--- a/content/common/content_navigation_policy.cc
+++ b/content/common/content_navigation_policy.cc
@@ -27,11 +27,15 @@ bool DeviceHasEnoughMemoryForBackForwardCache() {
   // It is important to check the base::FeatureList to avoid activating any
   // field trial groups if BFCache is disabled due to memory threshold.
   if (base::FeatureList::IsEnabled(features::kBackForwardCacheMemoryControls)) {
-    // On Android, BackForwardCache is enabled for devices with 1200MB memory or
-    // above.
+    // On Android, BackForwardCache is enabled for devices sold with 4GB of
+    // memory or more. Cached pages keep their renderers alive, which raises
+    // memory use; under memory pressure those renderers can be killed, making
+    // some history navigations slower. The kernel reports less than the
+    // installed memory, so the threshold is 3276MiB, approximately the 3.2GiB
+    // boundary between 3GB and 4GB devices in base::SysInfo.
     int default_memory_threshold_mb =
 #if BUILDFLAG(IS_ANDROID)
-        1200;
+        3276;
 #else
         // Desktop has lower memory limitations compared to Android allowing us
         // to enable BackForwardCache for all devices.
