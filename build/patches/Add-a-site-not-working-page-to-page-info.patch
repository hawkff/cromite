+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.chromium.chrome.browser.page_info;
+
+import android.content.res.Resources;
+import android.view.View;
+import android.view.ViewGroup;
+
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.components.adblock.AdblockController;
+import org.chromium.components.browser_ui.site_settings.ContentSettingsResources;
+import org.chromium.components.browser_ui.site_settings.WebsitePreferenceBridge;
+import org.chromium.components.content_settings.ContentSetting;
+import org.chromium.components.content_settings.ContentSettingsType;
+import org.chromium.components.content_settings.CookieControlsBridge;
+import org.chromium.components.content_settings.CookieControlsEnforcement;
+import org.chromium.components.content_settings.CookieControlsObserver;
+import org.chromium.components.content_settings.CookieControlsState;
+import org.chromium.components.embedder_support.util.UrlUtilities;
+import org.chromium.components.page_info.PageInfoControllerDelegate;
+import org.chromium.components.page_info.PageInfoMainController;
+import org.chromium.components.page_info.PageInfoPreferenceSubpageController;
+import org.chromium.components.page_info.PageInfoRowView;
+import org.chromium.url.GURL;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Page info row "Site not working?" and its subpage: the protections that most often stop a site
+ * from working, each with a switch for this site. One button turns them off for this site; once
+ * any is off, the same button removes this site's own exceptions for them, so the settings for
+ * all sites apply again. Only per-site settings are written; global settings never change.
+ */
+@NullMarked
+public class PageInfoSiteProtectionsController extends PageInfoPreferenceSubpageController
+        implements CookieControlsObserver {
+    public static final int ROW_ID = View.generateViewId();
+
+    // Changed together by the button, in the order shown. Third-party cookies go with them.
+    private static final int[] RELAXED_TOGETHER = {
+        ContentSettingsType.ADS,
+        ContentSettingsType.JAVASCRIPT_JIT,
+        ContentSettingsType.VIEWPORT,
+        ContentSettingsType.PROTECTED_KEYBOARD_GEOMETRY,
+        ContentSettingsType.TIMEZONE_OVERRIDE,
+    };
+
+    private final PageInfoMainController mMainController;
+    private final PageInfoRowView mRowView;
+    private final Profile mProfile;
+    private final GURL mUrl;
+    private @Nullable PageInfoSiteProtectionsSettings mSubPage;
+    private @CookieControlsState int mCookieState = CookieControlsState.HIDDEN;
+    private @CookieControlsEnforcement int mCookieEnforcement =
+            CookieControlsEnforcement.NO_ENFORCEMENT;
+    // What the button on the subpage currently says; a tap does what it says.
+    private boolean mButtonTurnsProtectionsOn;
+
+    public PageInfoSiteProtectionsController(
+            PageInfoMainController mainController,
+            PageInfoRowView rowView,
+            PageInfoControllerDelegate delegate,
+            Profile profile) {
+        super(delegate);
+        mMainController = mainController;
+        mRowView = rowView;
+        mProfile = profile;
+        mUrl = mainController.getURL();
+        // Page info swaps the main view out for every subpage, so the row is attached again
+        // after the cookie page or any other subpage may have changed something.
+        mRowView.addOnAttachStateChangeListener(
+                new View.OnAttachStateChangeListener() {
+                    @Override
+                    public void onViewAttachedToWindow(View view) {
+                        refreshCookieState();
+                        updateRow();
+                    }
+
+                    @Override
+                    public void onViewDetachedFromWindow(View view) {}
+                });
+        updateRow();
+    }
+
+    private void updateRow() {
+        PageInfoRowView.ViewParams params = new PageInfoRowView.ViewParams();
+        params.visible =
+                getDelegate().isSiteSettingsAvailable() && UrlUtilities.isHttpOrHttps(mUrl);
+        Resources resources = mRowView.getContext().getResources();
+        params.title = resources.getString(R.string.page_info_site_protections_title);
+        params.subtitle =
+                resources.getString(
+                        isRelaxed()
+                                ? R.string.page_info_site_protections_row_relaxed
+                                : R.string.page_info_site_protections_row);
+        params.iconResId = R.drawable.page_info_shield_question;
+        params.clickCallback = () -> mMainController.launchSubpage(this);
+        mRowView.setParams(params);
+    }
+
+    /** Whether the protection of a content setting type is on with this value. */
+    private static boolean isProtecting(int type, @ContentSetting int value) {
+        // For these two, allowed means the protection is applied.
+        if (type == ContentSettingsType.VIEWPORT
+                || type == ContentSettingsType.PROTECTED_KEYBOARD_GEOMETRY) {
+            return value == ContentSetting.ALLOW;
+        }
+        return value != ContentSetting.ALLOW;
+    }
+
+    /** The value that applies the protection; for the time zone, a random one. */
+    private static @ContentSetting int protectingValue(int type) {
+        return isProtecting(type, ContentSetting.ALLOW)
+                ? ContentSetting.ALLOW
+                : ContentSetting.BLOCK;
+    }
+
+    private static @ContentSetting int relaxedValue(int type) {
+        return protectingValue(type) == ContentSetting.ALLOW
+                ? ContentSetting.BLOCK
+                : ContentSetting.ALLOW;
+    }
+
+    private @ContentSetting int getSetting(int type) {
+        return WebsitePreferenceBridge.getContentSetting(mProfile, type, mUrl, mUrl);
+    }
+
+    private boolean isProtectingForAllSites(int type) {
+        return isProtecting(type, WebsitePreferenceBridge.getDefaultContentSetting(mProfile, type));
+    }
+
+    private boolean isAdBlockingEnabled() {
+        try {
+            return AdblockController.getInstance(mProfile.getOriginalProfile()).isEnabled();
+        } catch (IllegalStateException e) {
+            return false;
+        }
+    }
+
+    /**
+     * Whether the ad blocker's own "Allowed sites" list exempts this site, matching the filter it
+     * makes for each entry: the domain itself and every subdomain.
+     */
+    private boolean isOnAdBlockingAllowList() {
+        String host = mUrl.getHost().toLowerCase(Locale.ROOT);
+        try {
+            for (String domain :
+                    AdblockController.getInstance(mProfile.getOriginalProfile())
+                            .getAllowedDomains()) {
+                String allowed = domain.trim().toLowerCase(Locale.ROOT);
+                if (allowed.isEmpty()) continue;
+                if (host.equals(allowed) || host.endsWith("." + allowed)) return true;
+            }
+        } catch (IllegalStateException e) {
+            return false;
+        }
+        return false;
+    }
+
+    private boolean isOn(int type) {
+        if (type == ContentSettingsType.ADS && !isChangeable(type)) return false;
+        return isProtecting(type, getSetting(type));
+    }
+
+    /** Listed when the protection is on for this site or for all sites. */
+    private boolean isListed(int type) {
+        return isOn(type) || isProtectingForAllSites(type);
+    }
+
+    /**
+     * Whether this site's switch can change the protection. Ad blocking turned off for all sites,
+     * or for this site in the ad blocker's own list, is changed only in the ad blocking settings,
+     * which this page never writes.
+     */
+    private boolean isChangeable(int type) {
+        return type != ContentSettingsType.ADS
+                || (isAdBlockingEnabled() && !isOnAdBlockingAllowList());
+    }
+
+    private boolean isCookieSwitchChangeable() {
+        return mCookieState != CookieControlsState.HIDDEN
+                && mCookieEnforcement == CookieControlsEnforcement.NO_ENFORCEMENT;
+    }
+
+    /** Whether any protection of the button's set is off for this site right now. */
+    private boolean isRelaxed() {
+        if (mCookieState == CookieControlsState.ALLOWED3PC && isCookieSwitchChangeable()) {
+            return true;
+        }
+        for (int type : RELAXED_TOGETHER) {
+            if (isListed(type) && isChangeable(type) && !isOn(type)) return true;
+        }
+        return false;
+    }
+
+    private void turnOff(int type) {
+        WebsitePreferenceBridge.setContentSettingDefaultScope(
+                mProfile, type, mUrl, mUrl, relaxedValue(type));
+    }
+
+    /**
+     * Removes this site's own exception, so the setting for all sites applies. If an exception
+     * covering more sites still leaves the protection off while the setting for all sites has it
+     * on, this site gets the value of the setting for all sites (a custom time zone or blocking
+     * all pop-ups stays as chosen there).
+     */
+    private void turnOn(int type) {
+        WebsitePreferenceBridge.setContentSettingDefaultScope(
+                mProfile, type, mUrl, mUrl, ContentSetting.DEFAULT);
+        if (!isOn(type) && isProtectingForAllSites(type)) {
+            WebsitePreferenceBridge.setContentSettingDefaultScope(
+                    mProfile,
+                    type,
+                    mUrl,
+                    mUrl,
+                    WebsitePreferenceBridge.getDefaultContentSetting(mProfile, type));
+        }
+    }
+
+    /** Reads the third-party cookie state; the bridge reports it while it is created. */
+    private void refreshCookieState() {
+        mCookieState = CookieControlsState.HIDDEN;
+        mCookieEnforcement = CookieControlsEnforcement.NO_ENFORCEMENT;
+        getDelegate().createCookieControlsBridge(this).destroy();
+    }
+
+    /**
+     * Changes this site's third-party cookie exception. The bridge is destroyed without its own
+     * reload on closing; page info reloads the page once when it closes.
+     */
+    private void setThirdPartyCookieBlocking(boolean block) {
+        if (!isCookieSwitchChangeable()) return;
+        CookieControlsBridge bridge = getDelegate().createCookieControlsBridge(this);
+        bridge.setThirdPartyCookieBlockingEnabledForSite(block);
+        bridge.destroy();
+        // Page info's own cookie row and page keep their state from their own bridge.
+        mMainController.refreshCookieControls();
+    }
+
+    @Override
+    public String getSubpageTitle() {
+        return mRowView.getContext().getString(R.string.page_info_site_protections_title);
+    }
+
+    @Override
+    public @Nullable View createViewForSubpage(ViewGroup parent) {
+        assert mSubPage == null;
+        if (!canCreateSubpageFragment()) return null;
+        mSubPage = new PageInfoSiteProtectionsSettings();
+        View view = addSubpageFragment(mSubPage);
+        refreshCookieState();
+        updateSubpage();
+        return view;
+    }
+
+    private void updateSubpage() {
+        if (mSubPage == null) return;
+        Resources resources = mRowView.getContext().getResources();
+        boolean relaxed = isRelaxed();
+        mButtonTurnsProtectionsOn = relaxed;
+        String host = mUrl.getHost();
+        mSubPage.setHeader(
+                relaxed
+                        ? resources.getString(
+                                R.string.page_info_site_protections_intro_relaxed, host)
+                        : resources.getString(R.string.page_info_site_protections_intro, host),
+                resources.getString(
+                        relaxed
+                                ? R.string.page_info_site_protections_restore
+                                : R.string.page_info_site_protections_relax),
+                this::onButtonClicked);
+
+        List<PageInfoSiteProtectionsSettings.Row> rows = new ArrayList<>();
+        for (int type : RELAXED_TOGETHER) {
+            if (isListed(type)) rows.add(createRow(type));
+            if (type == ContentSettingsType.ADS && mCookieState != CookieControlsState.HIDDEN) {
+                rows.add(
+                        new PageInfoSiteProtectionsSettings.Row(
+                                ContentSettingsResources.getIcon(ContentSettingsType.COOKIES),
+                                resources.getString(R.string.page_info_site_protections_cookies),
+                                resources.getString(getCookieSummary()),
+                                mCookieState == CookieControlsState.BLOCKED3PC,
+                                isCookieSwitchChangeable(),
+                                block -> {
+                                    setThirdPartyCookieBlocking(block);
+                                    onChanged();
+                                }));
+            }
+        }
+        if (isListed(ContentSettingsType.POPUPS)) rows.add(createRow(ContentSettingsType.POPUPS));
+        mSubPage.setRows(rows);
+    }
+
+    private int getCookieSummary() {
+        switch (mCookieEnforcement) {
+            case CookieControlsEnforcement.ENFORCED_BY_POLICY:
+                return R.string.page_info_site_protections_cookies_policy;
+            case CookieControlsEnforcement.ENFORCED_BY_EXTENSION:
+                return R.string.page_info_site_protections_cookies_extension;
+            case CookieControlsEnforcement.ENFORCED_BY_COOKIE_SETTING:
+                return R.string.page_info_site_protections_cookies_exception;
+            default:
+                return R.string.page_info_site_protections_cookies_summary;
+        }
+    }
+
+    private PageInfoSiteProtectionsSettings.Row createRow(int type) {
+        Resources resources = mRowView.getContext().getResources();
+        int titleRes;
+        int summaryRes;
+        switch (type) {
+            case ContentSettingsType.ADS:
+                titleRes = R.string.page_info_site_protections_ads;
+                if (!isAdBlockingEnabled()) {
+                    summaryRes = R.string.page_info_site_protections_ads_off_everywhere;
+                } else if (isOnAdBlockingAllowList()) {
+                    summaryRes = R.string.page_info_site_protections_ads_allowed_in_settings;
+                } else {
+                    summaryRes = R.string.page_info_site_protections_ads_summary;
+                }
+                break;
+            case ContentSettingsType.JAVASCRIPT_JIT:
+                titleRes = R.string.page_info_site_protections_jit;
+                summaryRes = R.string.page_info_site_protections_jit_summary;
+                break;
+            case ContentSettingsType.VIEWPORT:
+                titleRes = R.string.page_info_site_protections_viewport;
+                summaryRes = R.string.page_info_site_protections_viewport_summary;
+                break;
+            case ContentSettingsType.PROTECTED_KEYBOARD_GEOMETRY:
+                titleRes = R.string.page_info_site_protections_keyboard;
+                summaryRes = R.string.page_info_site_protections_keyboard_summary;
+                break;
+            case ContentSettingsType.TIMEZONE_OVERRIDE:
+                titleRes = R.string.page_info_site_protections_time_zone;
+                summaryRes = R.string.page_info_site_protections_time_zone_summary;
+                break;
+            default:
+                assert type == ContentSettingsType.POPUPS;
+                titleRes = R.string.page_info_site_protections_popups;
+                summaryRes = R.string.page_info_site_protections_popups_summary;
+        }
+        return new PageInfoSiteProtectionsSettings.Row(
+                ContentSettingsResources.getIcon(type),
+                resources.getString(titleRes),
+                resources.getString(summaryRes),
+                isOn(type),
+                isChangeable(type),
+                on -> {
+                    if (on) {
+                        turnOn(type);
+                    } else {
+                        turnOff(type);
+                    }
+                    onChanged();
+                });
+    }
+
+    /** After a switch: reload once when page info closes, and show the new state. */
+    private void onChanged() {
+        mMainController.reloadPageWhenClosed();
+        updateRow();
+        // Rebuilt after the switch has finished handling its own change. Not posted to the row:
+        // the row is detached while the subpage is shown, and a detached view runs nothing.
+        PostTask.postTask(TaskTraits.UI_USER_VISIBLE, this::updateSubpage);
+    }
+
+    /**
+     * Turns off this site's protections of the button's set, or, when any of them is off, removes
+     * this site's own exceptions for all of them. Then closes page info, which reloads the page.
+     */
+    private void onButtonClicked() {
+        boolean relax = !mButtonTurnsProtectionsOn;
+        for (int type : RELAXED_TOGETHER) {
+            if (!isChangeable(type)) continue;
+            if (!relax) {
+                turnOn(type);
+            } else if (isOn(type)) {
+                turnOff(type);
+            }
+        }
+        if (relax ? mCookieState == CookieControlsState.BLOCKED3PC
+                : mCookieState == CookieControlsState.ALLOWED3PC) {
+            setThirdPartyCookieBlocking(!relax);
+        }
+        mMainController.reloadPageWhenClosed();
+        mMainController.dismiss();
+    }
+
+    @Override
+    public void onStatusChanged(
+            @CookieControlsState int controlsState,
+            @CookieControlsEnforcement int enforcement,
+            long expiration) {
+        mCookieState = controlsState;
+        mCookieEnforcement = enforcement;
+    }
+
+    @Override
+    public void onSubpageRemoved() {
+        mSubPage = null;
+        removeSubpageFragment();
+    }
+
+    @Override
+    public void clearData() {}
+
+    @Override
+    public void updateRowIfNeeded() {
+        updateRow();
+    }
+
+    @Override
+    public void updateSubpageIfNeeded() {}
+}
