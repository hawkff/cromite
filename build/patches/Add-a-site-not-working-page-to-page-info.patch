+package org.chromium.chrome.browser.page_info;
+
+import static org.chromium.build.NullUtil.assertNonNull;
+
+import android.content.Context;
+import android.os.Bundle;
+
+import androidx.annotation.DrawableRes;
+import androidx.preference.Preference;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.settings.ButtonPreference;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.browser_ui.settings.TextMessagePreference;
+import org.chromium.components.browser_ui.site_settings.BaseSiteSettingsFragment;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Page info subpage with the protections of one site that most often stop it from working. */
+@NullMarked
+public class PageInfoSiteProtectionsSettings extends BaseSiteSettingsFragment {
+    private static final String INTRO_PREFERENCE = "site_protections_intro";
+    private static final String BUTTON_PREFERENCE = "site_protections_button";
+
+    /** One protection switch. */
+    static class Row {
+        final @DrawableRes int iconResId;
+        final String title;
+        final String summary;
+        final boolean on;
+        final boolean enabled;
+        final Callback<Boolean> onChanged;
+
+        Row(
+                @DrawableRes int iconResId,
+                String title,
+                String summary,
+                boolean on,
+                boolean enabled,
+                Callback<Boolean> onChanged) {
+            this.iconResId = iconResId;
+            this.title = title;
+            this.summary = summary;
+            this.on = on;
+            this.enabled = enabled;
+            this.onChanged = onChanged;
+        }
+    }
+
+    private final List<Preference> mRowPreferences = new ArrayList<>();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle bundle, @Nullable String rootKey) {
+        // Remove this page if it is restored without its controller.
+        if (!hasSiteSettingsDelegate()) {
+            getParentFragmentManager().beginTransaction().remove(this).commit();
+            return;
+        }
+        SettingsUtils.addPreferencesFromResource(
+                this, R.xml.page_info_site_protections_preferences);
+    }
+
+    /** Sets the text above the switches and the button. */
+    void setHeader(String intro, String buttonText, Runnable onButtonClicked) {
+        TextMessagePreference introPreference = assertNonNull(findPreference(INTRO_PREFERENCE));
+        introPreference.setSummary(intro);
+        ButtonPreference button = assertNonNull(findPreference(BUTTON_PREFERENCE));
+        button.setTitle(buttonText);
+        button.setOnPreferenceClickListener(
+                preference -> {
+                    onButtonClicked.run();
+                    return true;
+                });
+    }
+
+    /** Replaces the protection switches. */
+    void setRows(List<Row> rows) {
+        for (Preference preference : mRowPreferences) {
+            getPreferenceScreen().removePreference(preference);
+        }
+        mRowPreferences.clear();
+        Context context = getPreferenceManager().getContext();
+        for (Row row : rows) {
+            ChromeSwitchPreference preference = new ChromeSwitchPreference(context);
+            preference.setIcon(SettingsUtils.getTintedIcon(context, row.iconResId));
+            preference.setTitle(row.title);
+            preference.setSummary(row.summary);
+            preference.setChecked(row.on);
+            preference.setEnabled(row.enabled);
+            preference.setOnPreferenceChangeListener(
+                    (p, newValue) -> {
+                        row.onChanged.onResult((Boolean) newValue);
+                        return true;
+                    });
+            getPreferenceScreen().addPreference(preference);
+            mRowPreferences.add(preference);
+        }
+    }
+}
