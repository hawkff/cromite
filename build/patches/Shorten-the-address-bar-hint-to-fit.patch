     private @Nullable String mAccessibilityWarning;
 
+    /** The hint before it is shortened to the width of the field. */
+    private @Nullable CharSequence mFullHint;
+
     protected boolean mRequestingAutofillStructure;
 
     /** Delegate used to communicate with the content side and the parent layout. */
@@ -1034,9 +1037,35 @@ public class UrlBar extends AutocompleteEditText {
         sendAccessibilityEvent(AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED);
     }
 
+    /**
+     * Sets the hint. A hint wider than the field ends with an ellipsis instead of being cut off,
+     * because an editable field does not ellipsize its hint.
+     */
+    public void setHintFittingWidth(@Nullable CharSequence hint) {
+        mFullHint = hint;
+        setHint(fitHintToWidth(hint));
+    }
+
+    private @Nullable CharSequence fitHintToWidth(@Nullable CharSequence hint) {
+        int width = getWidthWithoutCompoundPadding();
+        if (hint == null || width <= 0) return hint;
+        return TextUtils.ellipsize(hint, getPaint(), width, TextUtils.TruncateAt.END);
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        if (w != oldw && mFullHint != null) setHint(fitHintToWidth(mFullHint));
+    }
+
     @Override
     public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info) {
         super.onInitializeAccessibilityNodeInfo(info);
+        // Screen readers get the whole hint, not the shortened one.
