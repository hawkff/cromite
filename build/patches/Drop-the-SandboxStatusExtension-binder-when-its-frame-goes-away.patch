---
 chrome/renderer/sandbox_status_extension_android.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/chrome/renderer/sandbox_status_extension_android.cc b/chrome/renderer/sandbox_status_extension_android.cc
--- a/chrome/renderer/sandbox_status_extension_android.cc
+++ b/chrome/renderer/sandbox_status_extension_android.cc
@@ -46,6 +46,12 @@ void SandboxStatusExtension::Create(content::RenderFrame* frame) {
 }
 
 void SandboxStatusExtension::OnDestruct() {
+  // The interface binder holds a reference to this object. Drop it now, while
+  // the frame still tracks its observers: the frame destroys its interface
+  // registry only after it has stopped tracking them, and freeing this object
+  // from there would leave a dangling entry in the frame's observer list.
+  render_frame()->GetAssociatedInterfaceRegistry()->RemoveInterface(
+      chrome::mojom::SandboxStatusExtension::Name_);
   // This object is ref-counted, since a callback could still be in-flight.
   Release();
 }
