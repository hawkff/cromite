@@ -62,6 +61,7 @@ public class TouchDevice {
      */
     @CalledByNative
     private static int[] availablePointerAndHoverTypes() {
+        if ((true)) return new int[] {PointerType.COARSE, HoverType.NONE};
         int pointerTypes = 0;
         int hoverTypes = 0;
 
