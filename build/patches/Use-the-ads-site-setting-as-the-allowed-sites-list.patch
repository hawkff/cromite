+// The ads site setting pattern for a site typed on the Allowed sites page: the
+// site and its subdomains, or exactly the address for an IP address. Empty for
+// text that names no site.
+std::string AllowedSitePattern(const std::string& site) {
+  GURL url(site);
+  if (!url.is_valid() || !url.has_host()) {
+    url = GURL("http://" + site);
+  }
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_host()) {
+    return std::string();
+  }
+  const std::string host(url.host());
+  const bool is_ip_address = url.HostIsIPAddress();
+  const ContentSettingsPattern pattern = ContentSettingsPattern::FromString(
+      is_ip_address ? host : "[*.]" + host);
+  if (!pattern.IsValid() || pattern.MatchesAllHosts()) {
+    return std::string();
+  }
+  if (!is_ip_address) {
+    // The host as saved, after the pattern dropped trailing dots. Like the ad
+    // blocker's own domain option, a name needs a dot or must be "localhost",
+    // so that no top-level domain can be allowed as a whole.
+    const std::string& saved_host = pattern.GetHost();
+    if (saved_host != "localhost" &&
+        (saved_host.find('.') == std::string::npos ||
+         saved_host.starts_with('.') ||
+         saved_host.find("..") != std::string::npos ||
+         !base::ContainsOnlyChars(saved_host,
+                                  "abcdefghijklmnopqrstuvwxyz0123456789-."))) {
+      return std::string();
+    }
+  }
+  return pattern.ToString();
+}
+
+#if DCHECK_IS_ON()
+// Typed text and the pattern it must give; an empty pattern means rejected.
+void CheckAllowedSitePatterns() {
+  static constexpr struct {
+    const char* site;
+    const char* pattern;
+  } kCases[] = {
+      {"com", ""},
+      {"com.", ""},
+      {"example.com", "[*.]example.com"},
+      {"example.com.", "[*.]example.com"},
+      {"https://Example.com/path", "[*.]example.com"},
+      {"localhost", "[*.]localhost"},
+      {"127.1", "127.0.0.1"},
+      {"[::1]", "[::1]"},
+      {"*", ""},
+      {"*.example.com", ""},
+      {"example..com", ""},
+      {"xn--80ak6aa92e.com", "[*.]xn--80ak6aa92e.com"},
+      {"xn--p1ai", ""},
+  };
+  for (const auto& test_case : kCases) {
+    DCHECK_EQ(AllowedSitePattern(test_case.site), test_case.pattern)
+        << test_case.site;
+  }
+}
+#endif  // DCHECK_IS_ON()
+
 }  // namespace
 
 static void
@@ -246,4 +314,20 @@ JNI_AdblockController_GetRecommendedSubscriptions(JNIEnv* env) {
   return ToJavaArrayOfObjects(env, CSubscriptionsToJObjects(env, list));
 }
 
+static base::android::ScopedJavaLocalRef<jstring>
+JNI_AdblockController_ToAllowedSitePattern(
+    JNIEnv* env,
+    const base::android::JavaRef<jstring>& jsite) {
+#if DCHECK_IS_ON()
+  static const bool checked = (CheckAllowedSitePatterns(), true);
+  DCHECK(checked);
+#endif
+  const std::string pattern =
+      AllowedSitePattern(base::android::ConvertJavaStringToUTF8(env, jsite));
+  if (pattern.empty()) {
+    return ScopedJavaLocalRef<jstring>();
+  }
+  return ConvertUTF8ToJavaString(env, pattern);
+}
+
 DEFINE_JNI(AdblockController)
