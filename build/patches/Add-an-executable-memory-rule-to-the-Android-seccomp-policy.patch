+
+BPF_TEST_C(BaselinePolicyAndroid,
+           ExecMemory_DenyAllowsOtherMappings,
+           DenyExecMemoryBaselinePolicyAndroid) {
+  void* page = mmap(nullptr, 4096, PROT_READ | PROT_WRITE,
+                    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  BPF_ASSERT_NE(MAP_FAILED, page);
+  BPF_ASSERT_EQ(0, mprotect(page, 4096, PROT_READ));
+  BPF_ASSERT_EQ(0, munmap(page, 4096));
+}
+
+BPF_DEATH_TEST_C(BaselinePolicyAndroid,
+                 ExecMemory_DenyMmap,
+                 DEATH_SEGV_MESSAGE(GetExecMemoryErrorMessageContentForTests()),
+                 DenyExecMemoryBaselinePolicyAndroid) {
+  mmap(nullptr, 4096, PROT_READ | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1,
+       0);
+}
+
+BPF_DEATH_TEST_C(BaselinePolicyAndroid,
+                 ExecMemory_DenyMprotect,
+                 DEATH_SEGV_MESSAGE(GetExecMemoryErrorMessageContentForTests()),
+                 DenyExecMemoryBaselinePolicyAndroid) {
+  void* page = mmap(nullptr, 4096, PROT_READ | PROT_WRITE,
+                    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  BPF_ASSERT_NE(MAP_FAILED, page);
+  mprotect(page, 4096, PROT_READ | PROT_EXEC);
+}
+
+// The report mode performs the calls, so the kernel decides the result. It
+// must not crash, and memory without PROT_EXEC must stay usable.
+BPF_TEST_C(BaselinePolicyAndroid,
+           ExecMemory_ReportPerformsCalls,
+           ReportExecMemoryBaselinePolicyAndroid) {
+  void* page = mmap(nullptr, 4096, PROT_READ | PROT_EXEC,
+                    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (page != MAP_FAILED) {
+    BPF_ASSERT_EQ(0, munmap(page, 4096));
+  }
+  page = mmap(nullptr, 4096, PROT_READ | PROT_WRITE,
+              MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  BPF_ASSERT_NE(MAP_FAILED, page);
+  mprotect(page, 4096, PROT_READ | PROT_EXEC);
+  BPF_ASSERT_EQ(0, mprotect(page, 4096, PROT_READ | PROT_WRITE));
+  BPF_ASSERT_EQ(0, munmap(page, 4096));
+}
