+// Logs that the system call asked for executable memory, then crashes in the
+// same way as CrashSIGSYS_Handler.
+SANDBOX_EXPORT intptr_t
+SIGSYSExecMemoryFailure(const struct arch_seccomp_data& args, void* aux);
+
+// Logs an mmap(), mmap2(), mprotect() or pkey_mprotect() call that asks for
+// PROT_EXEC and the /proc/self/maps line of the affected memory, and returns
+// the result of performing the call. mprotect() and pkey_mprotect() are
+// performed with kExecMemoryReportMarker as the sixth argument, which the
+// kernel ignores, so that the policy can let them through. mmap() and mmap2()
+// are performed without PROT_EXEC, which such an mprotect() then adds.
+SANDBOX_EXPORT intptr_t
+SIGSYSExecMemoryReport(const struct arch_seccomp_data& args, void* aux);
+inline constexpr uintptr_t kExecMemoryReportMarker = 0x5e1f6a7e;
+
 // Variants of the above functions for use with bpf_dsl.
 SANDBOX_EXPORT bpf_dsl::ResultExpr CrashSIGSYS();
 SANDBOX_EXPORT bpf_dsl::ResultExpr CrashSIGSYSClone();
@@ -101,6 +116,8 @@ SANDBOX_EXPORT bpf_dsl::ResultExpr CrashSIGSYSSocket();
