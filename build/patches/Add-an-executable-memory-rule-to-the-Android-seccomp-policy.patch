+intptr_t SIGSYSExecMemoryFailure(const struct arch_seccomp_data& args,
+                                 void* aux) {
+  static constexpr char kSeccompExecMemoryError[] =
+      __FILE__ ":**CRASHING**:" SECCOMP_MESSAGE_EXEC_MEMORY_CONTENT "\n";
+  WriteToStdErr(kSeccompExecMemoryError, sizeof(kSeccompExecMemoryError) - 1);
+  return CrashSIGSYS_Handler(args, aux);
+}
+
+intptr_t SIGSYSExecMemoryReport(const struct arch_seccomp_data& args,
+                                void* aux) {
+  const intptr_t addr = static_cast<intptr_t>(args.args[0]);
+  const intptr_t len = static_cast<intptr_t>(args.args[1]);
+  const intptr_t prot = static_cast<intptr_t>(args.args[2]);
+  const intptr_t marker = static_cast<intptr_t>(kExecMemoryReportMarker);
+  const bool is_mprotect =
+      args.nr == __NR_mprotect || args.nr == __NR_pkey_mprotect;
+  intptr_t ret;
+  if (is_mprotect) {
+    ret = Syscall::Call(args.nr, addr, len, prot,
+                        static_cast<intptr_t>(args.args[3]),
+                        static_cast<intptr_t>(args.args[4]), marker);
+  } else {
+    ret = Syscall::Call(args.nr, addr, len, prot & ~PROT_EXEC,
+                        static_cast<intptr_t>(args.args[3]),
+                        static_cast<intptr_t>(args.args[4]),
+                        static_cast<intptr_t>(args.args[5]));
+    // Syscall::Call() returns -1 to -4095 on errors.
+    if (ret >= 0 || ret < -4095) {
+      const intptr_t protect_ret =
+          Syscall::Call(__NR_mprotect, ret, len, prot, 0, 0, marker);
+      if (protect_ret != 0) {
+        // The mapping without PROT_EXEC may already have replaced memory at a
+        // fixed address, so the request cannot be undone. End the process as
+        // the deny mode does.
+        static constexpr char kSeccompExecMemoryReplayError[] =
+            __FILE__ ":**CRASHING**:executable memory replay failure\n";
+        WriteToStdErr(kSeccompExecMemoryReplayError,
+                      sizeof(kSeccompExecMemoryReplayError) - 1);
+        return CrashSIGSYS_Handler(args, aux);
+      }
+    }
+  }
+
+  char message[256];
+  const size_t message_length = base::strings::SafeSPrintf(
+      message,
+      "executable memory request: nr=0x%x arg1=0x%x arg2=0x%x arg3=0x%x "
+      "arg4=0x%x arg5=0x%x ret=0x%x",
+      args.nr, args.args[0], args.args[1], args.args[2], args.args[3],
+      args.args[4], static_cast<uintptr_t>(ret));
+  WriteToStdErr(message, message_length);
+  if (is_mprotect || ret >= 0 || ret < -4095) {
+    WriteMapsLine(static_cast<uintptr_t>(is_mprotect ? addr : ret));
+  }
+  return ret;
+}
+
 bpf_dsl::ResultExpr CrashSIGSYS() {
   return bpf_dsl::Trap(CrashSIGSYS_Handler, nullptr);
 }
