+ResultExpr RestrictExecMemory(int sysno,
+                              ResultExpr fallback,
+                              bool report_only) {
+#if defined(__i386__)
+  // The legacy i386 mmap takes a pointer to its arguments, and |fallback|
+  // returns ENOSYS for it.
+  if (sysno == __NR_mmap) {
+    return fallback;
+  }
+#endif
+  CHECK(SyscallSets::IsMmap(sysno) || sysno == __NR_mprotect ||
+        sysno == __NR_pkey_mprotect);
+  const Arg<int> prot(2);
+  const BoolExpr no_exec = (prot & PROT_EXEC) == 0;
+  if (!report_only) {
+    return If(no_exec, std::move(fallback)).Else(CrashSIGSYSExecMemory());
+  }
+  if (SyscallSets::IsMmap(sysno)) {
+    return If(no_exec, std::move(fallback)).Else(ReportExecMemorySIGSYS());
+  }
+  // The report handler performs the call again with the marker.
+  const Arg<uintptr_t> marker(5);
+  return If(AnyOf(no_exec, marker == kExecMemoryReportMarker),
+            std::move(fallback))
+      .Else(ReportExecMemorySIGSYS());
+}
