+constexpr std::string_view kMapsLinePrefix = "executable memory map: ";
+using MapsLine = std::array<char, 512>;
+
+// Parses the lowercase hexadecimal number that starts at |*pos| in |line| and
+// ends with |terminator|, and moves |*pos| past the terminator.
+bool ParseMapsNumber(const MapsLine& line,
+                     size_t length,
+                     size_t* pos,
+                     char terminator,
+                     uintptr_t* value) {
+  *value = 0;
+  for (; *pos < length; ++*pos) {
+    const char c = line[*pos];
+    if (c == terminator) {
+      ++*pos;
+      return true;
+    }
+    if (c >= '0' && c <= '9') {
+      *value = *value * 16 + static_cast<uintptr_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      *value = *value * 16 + static_cast<uintptr_t>(c - 'a' + 10);
+    } else {
+      return false;
+    }
+  }
+  return false;
+}
+
+// Writes the line of /proc/self/maps whose address range contains |address|.
+void WriteMapsLine(uintptr_t address) {
+  const int fd = static_cast<int>(HANDLE_EINTR(
+      syscall(__NR_openat, AT_FDCWD, "/proc/self/maps", O_RDONLY | O_CLOEXEC)));
+  if (fd < 0) {
+    return;
+  }
+  MapsLine line;
+  size_t length = 0;
+  for (char c : kMapsLinePrefix) {
+    line[length++] = c;
+  }
+  bool found = false;
+  std::array<char, 1024> chunk;
+  ssize_t count = 0;
+  while (!found &&
+         (count = HANDLE_EINTR(read(fd, chunk.data(), chunk.size()))) > 0) {
+    for (size_t i = 0; i < static_cast<size_t>(count) && !found; ++i) {
+      if (chunk[i] != '\n') {
+        // Overlong lines are cut; the address range comes first.
+        if (length < line.size() - 1) {
+          line[length++] = chunk[i];
+        }
+        continue;
+      }
+      size_t pos = kMapsLinePrefix.size();
+      uintptr_t start = 0;
+      uintptr_t end = 0;
+      found = ParseMapsNumber(line, length, &pos, '-', &start) &&
+              ParseMapsNumber(line, length, &pos, ' ', &end) &&
+              start <= address && address < end;
+      if (!found) {
+        length = kMapsLinePrefix.size();
+      }
+    }
+  }
+  close(fd);
+  if (found) {
+    line[length] = '\0';
+    WriteToStdErr(line.data(), length);
+  }
+}
+
