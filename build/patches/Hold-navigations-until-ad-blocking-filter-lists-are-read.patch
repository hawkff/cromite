+bool SubscriptionServiceImpl::IsInitialized() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Disabled configurations have no maintainer and filter nothing.
+  return std::ranges::all_of(maintainers_, [](const auto& entry) {
+    return !entry.second || entry.second->IsInitialized();
+  });
+}
+
+void SubscriptionServiceImpl::RunWhenInitialized(base::OnceClosure callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (IsInitialized()) {
+    std::move(callback).Run();
+    return;
+  }
+  const bool first_waiter = initialized_callbacks_.empty();
+  initialized_callbacks_.push_back(std::move(callback));
+  if (!first_waiter) {
+    return;
+  }
+  for (auto& entry : maintainers_) {
+    if (entry.second && !entry.second->IsInitialized()) {
+      entry.second->RunWhenInitialized(
+          base::BindOnce(&SubscriptionServiceImpl::MaybeRunInitializedCallbacks,
+                         weak_ptr_factory_.GetWeakPtr()));
+    }
+  }
+}
+
+void SubscriptionServiceImpl::MaybeRunInitializedCallbacks() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // A callback may enable or install a configuration that is still loading.
+  // The callbacks after it then wait for that configuration too.
+  while (!initialized_callbacks_.empty() && IsInitialized()) {
+    base::OnceClosure callback = std::move(initialized_callbacks_.front());
+    initialized_callbacks_.erase(initialized_callbacks_.begin());
+    // A callback may also destroy this service.
+    base::WeakPtr<SubscriptionServiceImpl> weak_this =
+        weak_ptr_factory_.GetWeakPtr();
+    std::move(callback).Run();
+    if (!weak_this) {
+      return;
+    }
+  }
+}
+
 void SubscriptionServiceImpl::OnEnabledStateChanged(
     FilteringConfiguration* config) {
   auto it = std::ranges::find_if(maintainers_, [&](const auto& entry) {
@@ -329,6 +377,8 @@ void SubscriptionServiceImpl::OnEnabledStateChanged(
     // FilteringConfigurationMaintainer. This cancels all related operations and
     // frees all associated memory.
     it->second.reset();
+    // The disabled configuration may have been the last one still loading.
+    MaybeRunInitializedCallbacks();
   }
 }
 
@@ -341,10 +391,18 @@ void SubscriptionServiceImpl::OnSubscriptionUpdated(
 
 std::unique_ptr<FilteringConfigurationMaintainer>
 SubscriptionServiceImpl::MakeMaintainer(FilteringConfiguration* configuration) {
-  return maintainer_factory_.Run(
+  auto maintainer = maintainer_factory_.Run(
       configuration,
       base::BindRepeating(&SubscriptionServiceImpl::OnSubscriptionUpdated,
                           weak_ptr_factory_.GetWeakPtr()));
+  // Callers of RunWhenInitialized() also wait for configurations enabled while
+  // they wait.
+  if (maintainer && !initialized_callbacks_.empty()) {
+    maintainer->RunWhenInitialized(
+        base::BindOnce(&SubscriptionServiceImpl::MaybeRunInitializedCallbacks,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+  return maintainer;
 }
 
