@@ -17,7 +17,123 @@
 
 #include "chrome/browser/adblock/adblock_chrome_content_browser_client.h"
 
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
 #include "chrome/browser/profiles/profile.h"
+#include "components/adblock/content/browser/factories/subscription_service_factory.h"
+#include "components/adblock/core/subscription/subscription_service.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// A navigation waits for the installed filter lists at most this long. Reading
+// them takes well under a second, so reaching the limit means the disk or the
+// worker thread is stalled.
+constexpr base::TimeDelta kFilterListsWaitLimit = base::Seconds(5);
+
+adblock::SubscriptionService* GetSubscriptionService(
+    content::NavigationHandle& handle) {
+  // Off-the-record profiles filter with the lists of their original profile.
+  return adblock::SubscriptionServiceFactory::GetForBrowserContext(
+      Profile::FromBrowserContext(handle.GetWebContents()->GetBrowserContext())
+          ->GetOriginalProfile());
+}
+
+// Defers an HTTP or HTTPS navigation until the installed ad blocking filter
+// lists have been read, because requests are checked only against the lists
+// loaded at the time of the request. After kFilterListsWaitLimit the
+// navigation goes ahead without them.
+class FilterListsReadyNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit FilterListsReadyNavigationThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override { return MaybeDefer(); }
+  ThrottleCheckResult WillRedirectRequest() override { return MaybeDefer(); }
+  const char* GetNameForLogging() override {
+    return "FilterListsReadyNavigationThrottle";
+  }
+
+ private:
+  ThrottleCheckResult MaybeDefer() {
+    if (waited_) {
+      return PROCEED;
+    }
+    adblock::SubscriptionService* service =
+        GetSubscriptionService(*navigation_handle());
+    if (!service || service->IsInitialized()) {
+      return PROCEED;
+    }
+    waited_ = true;
+    waiting_ = true;
+    wait_start_ = base::TimeTicks::Now();
+    LOG(INFO) << "[eyeo] Navigation waits for the filter lists";
+    service->RunWhenInitialized(
+        base::BindOnce(&FilterListsReadyNavigationThrottle::StopWaiting,
+                       weak_ptr_factory_.GetWeakPtr(), /*lists_ready=*/true));
+    wait_limit_.Start(
+        FROM_HERE, kFilterListsWaitLimit,
+        base::BindOnce(&FilterListsReadyNavigationThrottle::StopWaiting,
+                       base::Unretained(this), /*lists_ready=*/false));
+    return DEFER;
+  }
+
+  void StopWaiting(bool lists_ready) {
+    if (!waiting_) {
+      return;
+    }
+    waiting_ = false;
+    wait_limit_.Stop();
+    if (lists_ready) {
+      LOG(INFO) << "[eyeo] Filter lists read, navigation resumes after "
+                << base::TimeTicks::Now() - wait_start_;
+    } else {
+      LOG(WARNING) << "[eyeo] Filter lists not read after "
+                   << kFilterListsWaitLimit
+                   << ", the navigation goes ahead without them";
+    }
+    // May delete this.
+    Resume();
+  }
+
+  // Set once this navigation has waited, so a redirect does not wait again.
+  bool waited_ = false;
+  // True while the navigation is deferred by this throttle.
+  bool waiting_ = false;
+  base::TimeTicks wait_start_;
+  base::OneShotTimer wait_limit_;
+  base::WeakPtrFactory<FilterListsReadyNavigationThrottle> weak_ptr_factory_{
+      this};
+};
+
+}  // namespace
+
+void AdblockChromeContentBrowserClient::CreateThrottlesForNavigation(
+    content::NavigationThrottleRegistry& registry) {
+  adblock::AdblockContentBrowserClient<
+      ChromeContentBrowserClient>::CreateThrottlesForNavigation(registry);
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  // Navigations that start after the lists were read need no throttle.
+  adblock::SubscriptionService* service = GetSubscriptionService(handle);
+  if (!service || service->IsInitialized()) {
+    return;
+  }
+  registry.AddThrottle(
+      std::make_unique<FilterListsReadyNavigationThrottle>(registry));
+}
 
