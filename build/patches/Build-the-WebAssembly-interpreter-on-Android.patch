 v8/gni/v8.gni                                 | 15 ++++++--
 .../arm64/interpreter-builtins-arm64.cc       |  4 +--
 .../interpreter/wasm-interpreter-objects.cc   | 12 +++----
 .../interpreter/wasm-interpreter-runtime.cc   | 36 +++++++++----------
 v8/src/wasm/interpreter/wasm-interpreter.cc   | 26 +++++++-------
 .../x64/interpreter-builtins-x64.cc           |  4 +--
 6 files changed, 53 insertions(+), 44 deletions(-)

diff --git a/v8/gni/v8.gni b/v8/gni/v8.gni
--- a/v8/gni/v8.gni
+++ b/v8/gni/v8.gni
@@ -150,9 +150,11 @@ declare_args() {
   # While arm64 uses the standard AAPCS64 calling convention, component builds
   # work without this restriction only on iOS due to platform-specific
   # build constraints.
+  # Android builds compile the snapshot in a Linux host toolchain, which must
+  # use the same setting as the device, because it changes the builtins list.
   v8_drumbrake_bounds_checks =
       (is_win && (is_asan || is_ubsan || is_msan || is_tsan)) ||
-      !(is_win || is_linux || is_mac || is_ios) ||
+      !(is_win || is_linux || is_mac || is_ios) || target_os == "android" ||
       (v8_current_cpu != "x64" && v8_current_cpu != "arm64") || !is_clang ||
       (is_component_build && target_os != "ios")
 
@@ -358,13 +360,20 @@ if (v8_enable_pointer_compression == "") {
 }
 
 # The Wasm interpreter is currently supported only on arm64 and x64, on
-# Windows, Linux, MacOS and tvOS.
+# Windows, Linux, MacOS, tvOS and Android.
 is_drumbrake_supported =
     v8_enable_webassembly && v8_enable_pointer_compression &&
     (v8_current_cpu == "x64" || v8_current_cpu == "arm64" ||
      v8_current_cpu == "riscv64") &&
     (target_os == "win" || target_os == "linux" || target_os == "mac" ||
-     target_os == "ios")
+     target_os == "ios" || target_os == "android")
+
+# Build arguments apply to every toolchain. Android builds also configure
+# 32-bit secondary toolchains, which have no pointer compression and cannot
+# build the interpreter, so leave it out there instead of failing.
+if (!is_drumbrake_supported) {
+  v8_enable_drumbrake = false
+}
 
 # Turbofan is enabled by default, except in lite mode.
 if (v8_enable_turbofan == "") {
