+    /**
+     * Recreates the activities that use the AMOLED black baseline palette when Android's color
+     * contrast setting changes, so they pick the matching contrast overlay. Installed once.
+     */
+    private static void listenForContrastChanges() {
+        if (sContrastListenerAdded || VERSION.SDK_INT < VERSION_CODES.UPSIDE_DOWN_CAKE) return;
+        Context appContext = ContextUtils.getApplicationContext();
+        UiModeManager uiModeManager = appContext.getSystemService(UiModeManager.class);
+        if (uiModeManager == null) return;
+        sContrastListenerAdded = true;
+        uiModeManager.addContrastChangeListener(
+                appContext.getMainExecutor(),
+                _ -> {
+                    if (ChromeColors.isAmoledDynamicColorsEnabled()) return;
+                    for (Activity activity : ApplicationStatus.getRunningActivities()) {
+                        if (ChromeColors.isAmoledBlackActive(activity)) activity.recreate();
+                    }
+                });
+    }
+
     protected void applySingleThemeOverlay(int themeOverlay) {
         getTheme().applyStyle(themeOverlay, /* force= */ true);
     }
