diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -3858,9 +3858,15 @@ void RenderProcessHostImpl::AppendRendererCommandLine(
   if (IsJitDisabled()) {
     AppendToCommaSeparatedSwitch(
         command_line, blink::switches::kJavaScriptFlags, "--jitless");
-    // disable jit but enable webassembly
-    // command_line->AppendSwitchASCII(blink::switches::kJavaScriptFlags,
-    //                                 "--no-maglev,--no-turbofan");
+    // Run WebAssembly in V8's interpreter, which generates no machine code.
+    // V8 builds without the interpreter ignore the flag and keep WebAssembly
+    // unavailable.
+    if (!IsPdf() &&
+        base::FeatureList::IsEnabled(
+            features::kWebAssemblyInterpreterWithoutJit)) {
+      AppendToCommaSeparatedSwitch(
+          command_line, blink::switches::kJavaScriptFlags, "--wasm-jitless");
+    }
   } else if (AreV8OptimizationsDisabled()) {
     AppendToCommaSeparatedSwitch(command_line,
                                  blink::switches::kJavaScriptFlags,
diff --git a/cromite_flags/chrome/browser/about_flags_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc b/cromite_flags/chrome/browser/about_flags_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc
