--- /dev/null
+++ b/cromite_flags/chrome/browser/about_flags_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc
@@ -0,0 +1,12 @@
+#ifdef FLAG_SECTION
+
+    {"webassembly-interpreter-without-jit",
+     "WebAssembly on sites with JIT blocked",
+     "Sites with JIT blocked can use WebAssembly. It runs in V8's "
+     "interpreter, which generates no machine code. Without this flag "
+     "WebAssembly is not available on those sites. The interpreter is much "
+     "slower than compiled code and is experimental in V8; modules that use "
+     "the newer exception handling instructions do not load.", kOsAll,
+     FEATURE_VALUE_TYPE(features::kWebAssemblyInterpreterWithoutJit)},
+
+#endif
diff --git a/cromite_flags/content/public/common/content_features_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc b/cromite_flags/content/public/common/content_features_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc
new file mode 100644
--- /dev/null
+++ b/cromite_flags/content/public/common/content_features_cc/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc
@@ -0,0 +1,4 @@
+// Runs WebAssembly in V8's interpreter in renderers that have JIT blocked.
+CROMITE_FEATURE(kWebAssemblyInterpreterWithoutJit,
+                "WebAssemblyInterpreterWithoutJit",
+                base::FEATURE_DISABLED_BY_DEFAULT);
diff --git a/cromite_flags/content/public/common/content_features_h/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc b/cromite_flags/content/public/common/content_features_h/Add-a-flag-to-run-WebAssembly-in-the-interpreter-when-JIT-is-blocked.inc
