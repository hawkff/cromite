+    @Override
+    protected void onClick() {
+        if (!mIsWidget || mAdapter == null) return;
+        // A site permission row stores only a choice made in this list, including the option
+        // already shown. Its spinner is not listened to, because a spinner also reports the
+        // option it shows after a new adapter is bound, and never reports choosing that option
+        // again.
+        ArrayAdapter<Object> adapter = mAdapter;
+        CharSequence[] labels = new CharSequence[adapter.getCount()];
+        for (int i = 0; i < labels.length; i++) labels[i] = String.valueOf(adapter.getItem(i));
+        new AlertDialog.Builder(getContext(), R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(getTitle())
+                .setSingleChoiceItems(
+                        labels,
+                        mSelectedIndex,
+                        (dialog, which) -> {
+                            dialog.dismiss();
+                            if (callChangeListener(adapter.getItem(which))) {
+                                setSelectedIndex(which);
+                            }
+                        })
+                .setNegativeButton(R.string.cancel, null)
+                .show();
+    }
