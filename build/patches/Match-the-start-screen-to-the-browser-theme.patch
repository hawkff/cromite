 /** Helper methods for supporting night mode. */
 @JNINamespace("night_mode")
 @NullMarked
 public class NightModeUtils {
+    /**
+     * Name of the start screen theme last passed to Android by this process, empty for the
+     * manifest theme. Android has no public getter, and this process is the only writer.
+     */
+    private static @Nullable String sStartScreenThemeName;
+
     private static @Nullable Boolean sNightModeSupportedForTest;
 
     /**
@@ -130,6 +139,38 @@ public class NightModeUtils {
         ChromeSharedPreferences.getInstance().writeInt(UI_THEME_SETTING, theme);
     }
 
+    /**
+     * Sets the theme of the start screen that Android 13 and later show on the next cold start, so
+     * that its color matches the first frame of the browser. Android keeps one such theme for the
+     * whole app, so custom tabs and web apps started from the home screen get it too.
+     *
+     * @param activity Any running activity of the browser.
+     */
+    public static void updateStartScreenTheme(Activity activity) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        boolean amoledBlack = ChromeColors.isAmoledBlackEnabled();
+        @StyleRes int theme =
+                switch (getThemeSetting()) {
+                    case ThemeType.LIGHT -> R.style.Theme_BrowserUI_StartScreen_Light;
+                    case ThemeType.DARK ->
+                            amoledBlack
+                                    ? R.style.Theme_BrowserUI_StartScreen_Black
+                                    : R.style.Theme_BrowserUI_StartScreen_Dark;
+                    // Without AMOLED black, the theme in the manifest follows the system already.
+                    default ->
+                            amoledBlack
+                                    ? R.style.Theme_BrowserUI_StartScreen_DayBlack
+                                    : Resources.ID_NULL;
+                };
+        // Android stores the theme by name. Each call goes to the system's package service, so
+        // call it once per process and then only when the theme changes.
+        String name =
+                theme == Resources.ID_NULL ? "" : activity.getResources().getResourceName(theme);
+        if (name.equals(sStartScreenThemeName)) return;
+        activity.getSplashScreen().setSplashScreenTheme(theme);
+        sStartScreenThemeName = name;
+    }
+
     /**
      * Returns the title to display for the given theme.
      *
