     void setStatusClickListener(View.OnClickListener listener) {
         setOnClickListener(listener);
+        // setOnClickListener() makes the view clickable even for a null listener.
+        setClickable(hasOnClickListeners());
+        updateMinimumWidth();
+    }
+
+    /** Specify whether the status view uses the wide minimum width. */
+    void setUseWideStatusIcon(boolean useWideStatusIcon) {
+        mUseWideStatusIcon = useWideStatusIcon;
+        updateMinimumWidth();
+    }
+
+    private void updateMinimumWidth() {
+        Resources res = getResources();
+        if (mUseWideStatusIcon) {
+            setMinimumWidth(res.getDimensionPixelSize(R.dimen.status_view_width_wide));
+            setGravity(Gravity.CENTER);
+            return;
+        }
+        // A tappable icon gets a full touch target. The extra width follows the icon, so the
+        // icon stays where it is.
+        setMinimumWidth(
+                res.getDimensionPixelSize(
+                        hasOnClickListeners()
+                                ? R.dimen.min_touch_target_size
+                                : R.dimen.status_view_width_narrow));
+        setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
     }
 
